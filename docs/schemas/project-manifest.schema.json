{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/project-manifest.schema.json",
  "title": "Stem Extraction Project Manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "audio", "separation", "stems"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string" },
    "title": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["upload", "url", "generated"] },
        "original_filename": { "type": "string" },
        "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rights": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["user_owned", "licensed", "public_domain", "unknown"]
            },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": ["sample_rate", "bit_depth", "channels", "duration_seconds"],
      "properties": {
        "sample_rate": { "type": "integer", "minimum": 8000 },
        "bit_depth": { "type": "integer", "enum": [16, 24, 32] },
        "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "lufs_integrated": { "type": "number" },
        "true_peak_dbtp": { "type": "number" }
      }
    },
    "musical": {
      "type": "object",
      "properties": {
        "bpm": { "type": "number", "minimum": 20, "maximum": 400 },
        "bpm_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "key": { "type": "string" },
        "key_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "beat_grid": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "beat"],
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "beat": { "type": "integer", "minimum": 1 },
              "bar": { "type": "integer", "minimum": 1 },
              "downbeat": { "type": "boolean" }
            }
          }
        },
        "chords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "symbol"],
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "minimum": 0 },
              "symbol": { "type": "string" }
            }
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "label"],
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "separation": {
      "type": "object",
      "required": ["backend", "mode"],
      "properties": {
        "backend": { "type": "string" },
        "model_version": { "type": "string" },
        "mode": { "type": "string", "enum": ["2-stem", "4-stem", "6-stem", "10-stem", "specialist"] },
        "null_test_rms_db": { "type": "number" }
      }
    },
    "stems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "file", "start_sample", "num_samples", "sample_rate", "channels"],
        "properties": {
          "name": { "type": "string" },
          "file": { "type": "string" },
          "start_sample": { "type": "integer", "const": 0 },
          "num_samples": { "type": "integer", "minimum": 1 },
          "sample_rate": { "type": "integer" },
          "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
          "lufs_integrated": { "type": "number" },
          "true_peak_dbtp": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "midi_file": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tempo_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "bpm"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "bpm": { "type": "number", "minimum": 20, "maximum": 400 }
        }
      }
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["gain", "pan", "mute", "solo", "pitch", "timestretch", "replace", "regenerate"]
          },
          "stem": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["zip_wav", "reaper_rpp", "ableton_folder", "logic_folder", "midi_pack"]
          },
          "path": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "scorecard": {
      "type": "object",
      "properties": {
        "separation_quality": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "alignment_quality": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "musicality": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "at"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
