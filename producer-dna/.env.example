# Producer DNA Research OS — Environment Configuration
# Copy to .env and fill in values

# PostgreSQL connection string
DATABASE_URL=postgresql://localhost/pdna_dev

# Test database (used by pytest)
TEST_DATABASE_URL=postgresql://localhost/pdna_test

# MusicBrainz (no auth needed; User-Agent is set in code)
# Optionally throttle to be polite (default 1.0s between calls)
MB_RATE_LIMIT=1.0

# Discogs API — create an app at https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_TOKEN=

# Cache directory for API responses (7-day TTL)
PDNA_CACHE_DIR=~/.cache/pdna

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
