FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/workspace/models/huggingface \
    TORCH_HOME=/workspace/models/torch \
    SEPARATOR_MODEL_DIR=/workspace/models/separator \
    SEPARATOR_DATA_DIR=/workspace/stem-agent/jobs \
    DEMUCS_DEVICE=cuda \
    SAM_AUDIO_DEVICE=cuda \
    SEPARATOR_JOB_WORKERS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git libsndfile1 tini ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG TORCH_VERSION=2.11.0
ARG TORCHVISION_VERSION=0.26.0
ARG TORCHAUDIO_VERSION=2.11.0
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
RUN python -m pip install --upgrade pip \
    && python -m pip install torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION} torchaudio==${TORCHAUDIO_VERSION} --index-url ${TORCH_INDEX_URL}

COPY requirements.txt requirements-gpu.txt ./
RUN python -m pip install -r requirements.txt \
    && python -m pip install -r requirements-gpu.txt
COPY app.py agent_core.py agent_api.py stem_catalog.json ./
RUN mkdir -p /workspace/models/huggingface /workspace/models/torch /workspace/models/separator /workspace/stem-agent/jobs

EXPOSE 8000
VOLUME ["/workspace"]
HEALTHCHECK --interval=30s --timeout=8s --start-period=90s --retries=6 \
  CMD python -c "import json,urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8000/agent/ready',timeout=5)); raise SystemExit(0 if data.get('ready') else 1)"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "agent_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
