FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SEPARATOR_DATA_DIR=/data/jobs \
    SEPARATOR_MODEL_DIR=/data/models \
    TORCH_HOME=/data/models/torch \
    DEMUCS_DEVICE=cpu \
    SEPARATOR_JOB_WORKERS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG TORCH_VERSION=2.11.0
ARG TORCHAUDIO_VERSION=2.11.0
RUN python -m pip install --upgrade pip \
    && python -m pip install torch==${TORCH_VERSION} torchaudio==${TORCHAUDIO_VERSION} --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt ./
RUN python -m pip install -r requirements.txt
COPY app.py agent_core.py agent_api.py stem_catalog.json ./
RUN mkdir -p /data/jobs /data/models

EXPOSE 8000
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=4 \
  CMD python -c "import json,urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8000/agent/ready',timeout=5)); raise SystemExit(0 if data.get('ready') else 1)"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "agent_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
