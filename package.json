{
  "name": "music-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo containing the Agentic Beat Lab OS (Next.js) and the Music player (Vite).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:beat-lab": "npm run dev -w beat-lab",
    "dev:player": "npm run dev -w music-player",
    "build:beat-lab": "npm run build -w beat-lab",
    "build:player": "npm run build -w music-player",
    "lint:beat-lab": "npm run lint -w beat-lab",
    "lint:player": "npm run lint -w music-player"
  }
}
