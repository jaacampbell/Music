{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Music OS command center with a standalone browser music player",
  "scripts": {
    "predev": "node scripts/copy-basic-pitch-model.mjs",
    "dev": "next dev",
    "dev:player": "npm --prefix apps/player run dev",
    "prebuild": "node scripts/copy-basic-pitch-model.mjs",
    "build": "next build",
    "build:player": "npm --prefix apps/player run build",
    "start": "next start",
    "lint": "eslint .",
    "lint:player": "npm --prefix apps/player run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaacampbell/Music.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jaacampbell/Music/issues"
  },
  "homepage": "https://github.com/jaacampbell/Music#readme",
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
