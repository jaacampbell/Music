# Music OS cloud persistence
# Run db/music-os-phase2.sql, db/music-os-phase3.sql, db/music-os-phase4.sql,
# db/music-os-phase5.sql, db/music-os-phase6.sql, db/music-os-phase7.sql,
# db/music-os-phase11.sql, db/music-os-phase12.sql, then db/music-os-phase13.sql in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Ask Music AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-YOUR_SERVER_KEY
OPENAI_MUSIC_MODEL=gpt-5-mini

# Stem Director gateway signing secret.
# Must match Netlify and every worker. Never expose with NEXT_PUBLIC_.
SEPARATOR_GATEWAY_SECRET=replace-with-a-long-random-secret

# Phase 11/12 Worker Mesh + durable recovery.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
STEM_WORKER_HEARTBEAT_SECONDS=15

# Custom/non-RunPod workers must provide a stable public HTTPS origin and identity.
# WORKER_PROVIDER=custom
# WORKER_PROVIDER_NODE_ID=worker-01
# WORKER_NODE_ID=custom:worker-01
# WORKER_PUBLIC_URL=https://worker-01.example.com
# WORKER_REGION=us-central
# WORKER_COST_PER_HR=0.00

# Optional static rollback worker. New production deployments should normally leave
# this unset and let Worker Mesh route jobs from Supabase heartbeats.
# NEXT_PUBLIC_SEPARATOR_URL=https://YOUR_STATIC_FALLBACK_WORKER

# Optional worker-side strategy planner.
STEM_AGENT_USE_LLM=true
STEM_AGENT_MODEL=gpt-5-mini

# Hierarchical routing / same-node recovery behavior.
STEM_AGENT_HIERARCHICAL=true
SEPARATOR_RESUME_ON_START=true
SEPARATOR_MAX_RESTART_RESUMES=2
SEPARATOR_CLOUD_SYNC_INTERVAL_SECONDS=2

# Phase 13 trusted VPS compute controller.
# These credentials belong ONLY on the always-on controller/VPS, never in Netlify
# browser variables and never on the GPU worker. The controller manages an existing,
# pre-approved Pod; it never auto-creates one.
# SUPABASE_SERVICE_ROLE_KEY=server-only-controller-key
# RUNPOD_API_KEY=server-only-provider-key
# RUNPOD_STEM_POD_ID=approved-existing-pod
# STEM_CONTROLLER_AUTO_START=false
# STEM_CONTROLLER_ACCEPT_GPU_CHARGES=
# STEM_CONTROLLER_AUTO_STOP=false
# STEM_CONTROLLER_IDLE_SECONDS=600
# STEM_CONTROLLER_POLL_SECONDS=5
# STEM_CONTROLLER_PORT=8080

# To authorize paid wake-on-demand only after the Pod has been provisioned and tested:
# STEM_CONTROLLER_AUTO_START=true
# STEM_CONTROLLER_ACCEPT_GPU_CHARGES=I ACCEPT GPU CHARGES
# STEM_CONTROLLER_AUTO_STOP=true

# Phase 7/11/12 worker -> Supabase gateways.
# The GPU worker derives an HMAC key from SEPARATOR_GATEWAY_SECRET and sends lifecycle,
# mesh-heartbeat and durable-source requests to Supabase Edge Functions. GPU workers
# do not need a Supabase admin/service-role key.
