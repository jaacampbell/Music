# Music OS Phase 2 cloud persistence
# Create a Supabase project, run db/music-os-phase2.sql, then copy the values
# from the Supabase project Connect/API settings into your deployment environment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Existing real stem separator worker
NEXT_PUBLIC_SEPARATOR_URL=https://YOUR_SEPARATOR_WORKER
