# Music OS cloud persistence
# Run db/music-os-phase2.sql, db/music-os-phase3.sql, then db/music-os-phase4.sql in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Ask Music AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-YOUR_SERVER_KEY
OPENAI_MUSIC_MODEL=gpt-5-mini

# Agentic Stem System worker
NEXT_PUBLIC_SEPARATOR_URL=https://YOUR_GPU_WORKER
# Must be the same random secret on Netlify and the GPU worker. Never expose with NEXT_PUBLIC_.
SEPARATOR_GATEWAY_SECRET=replace-with-a-long-random-secret

# Optional worker-side strategy planner (set these on the worker host, not necessarily Netlify).
STEM_AGENT_USE_LLM=true
STEM_AGENT_MODEL=gpt-5-mini
