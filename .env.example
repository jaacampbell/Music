# Music OS cloud persistence
# Run db/music-os-phase2.sql and then db/music-os-phase3.sql in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Ask Music AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-YOUR_SERVER_KEY
OPENAI_MUSIC_MODEL=gpt-5-mini

# Existing real stem separator worker
NEXT_PUBLIC_SEPARATOR_URL=https://YOUR_SEPARATOR_WORKER
