# Music OS cloud persistence
# Run db/music-os-phase2.sql, db/music-os-phase3.sql, db/music-os-phase4.sql, then db/music-os-phase5.sql in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Ask Music AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-YOUR_SERVER_KEY
OPENAI_MUSIC_MODEL=gpt-5-mini

# Agentic Stem System worker
NEXT_PUBLIC_SEPARATOR_URL=https://YOUR_GPU_WORKER
# Must be the same random secret on Netlify and the GPU worker. Never expose with NEXT_PUBLIC_.
SEPARATOR_GATEWAY_SECRET=replace-with-a-long-random-secret

# Optional worker-side strategy planner (set on the worker host).
STEM_AGENT_USE_LLM=true
STEM_AGENT_MODEL=gpt-5-mini

# Phase 5 worker behavior.
STEM_AGENT_HIERARCHICAL=true
SEPARATOR_RESUME_ON_START=true
SEPARATOR_MAX_RESTART_RESUMES=2
SEPARATOR_CLOUD_SYNC_INTERVAL_SECONDS=2

# Optional worker -> Supabase lifecycle mirror. Keep this secret on the GPU worker only.
# Prefer a dedicated Supabase sb_secret_... key for the worker. It bypasses RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_WORKER_ONLY_KEY
