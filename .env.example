# Music OS cloud persistence
# Run db/music-os-phase2.sql, db/music-os-phase3.sql, db/music-os-phase4.sql,
# db/music-os-phase5.sql, db/music-os-phase6.sql, db/music-os-phase7.sql,
# then db/music-os-phase11.sql in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Ask Music AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-YOUR_SERVER_KEY
OPENAI_MUSIC_MODEL=gpt-5-mini

# Stem Director gateway signing secret.
# Must match Netlify and every worker. Never expose with NEXT_PUBLIC_.
SEPARATOR_GATEWAY_SECRET=replace-with-a-long-random-secret

# Phase 11 Worker Mesh
# Workers heartbeat to Supabase and are selected dynamically by the token gateway.
# RunPod automatically provides RUNPOD_POD_ID/RUNPOD_DC_ID/CUDA_VERSION.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
STEM_WORKER_HEARTBEAT_SECONDS=15

# Custom/non-RunPod workers must provide a stable public HTTPS origin and identity.
# WORKER_PROVIDER=custom
# WORKER_PROVIDER_NODE_ID=worker-01
# WORKER_NODE_ID=custom:worker-01
# WORKER_PUBLIC_URL=https://worker-01.example.com
# WORKER_REGION=us-central
# WORKER_COST_PER_HR=0.00

# Optional static rollback worker. New production deployments should normally leave
# this unset and let Worker Mesh route jobs from Supabase heartbeats.
# NEXT_PUBLIC_SEPARATOR_URL=https://YOUR_STATIC_FALLBACK_WORKER

# Optional worker-side strategy planner.
STEM_AGENT_USE_LLM=true
STEM_AGENT_MODEL=gpt-5-mini

# Hierarchical routing / recovery behavior.
STEM_AGENT_HIERARCHICAL=true
SEPARATOR_RESUME_ON_START=true
SEPARATOR_MAX_RESTART_RESUMES=2
SEPARATOR_CLOUD_SYNC_INTERVAL_SECONDS=2

# Phase 7/11 worker -> Supabase gateways.
# The worker derives an HMAC key from SEPARATOR_GATEWAY_SECRET and sends signed
# lifecycle envelopes to stem-worker-mirror plus signed mesh heartbeats to
# stem-worker-heartbeat. The Edge Functions own privileged database credentials;
# the GPU host does not need a Supabase admin/service-role key.

# Phase 6 direct RPC / admin-key modes are retained only as rollback code and
# should not be configured for new workers.
